// Tang Nano 20K (GW2AR-LV18QN88C8/I7) + 40 ピン RGB LCD (800x480)
// LCD のピンは sipeed/TangNano-20K-example の rgb_lcd/lcd_800_400 と Sipeed のピン配置図に合わせている。
// R/G の一部 (33〜40) は HDMI と同じピンなので、HDMI 用のビットストリームとは同時に使えない。
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "btn_s1" 88;
IO_PORT "btn_s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "btn_s2" 87;
IO_PORT "btn_s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "led[0]" 15;
IO_LOC  "led[1]" 16;
IO_LOC  "led[2]" 17;
IO_LOC  "led[3]" 18;
IO_LOC  "led[4]" 19;
IO_LOC  "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// バックライト駆動回路のイネーブル (1 で点灯)
IO_LOC  "lcd_bl" 49;
IO_PORT "lcd_bl" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=8;

// --- 映像信号 ---
IO_LOC  "lcd_clk"   77;
IO_LOC  "lcd_hsync" 25;
IO_LOC  "lcd_vsync" 26;
IO_LOC  "lcd_de"    48;
IO_LOC  "lcd_r[0]"  42;
IO_LOC  "lcd_r[1]"  41;
IO_LOC  "lcd_r[2]"  40;
IO_LOC  "lcd_r[3]"  39;
IO_LOC  "lcd_r[4]"  38;
IO_LOC  "lcd_g[0]"  37;
IO_LOC  "lcd_g[1]"  36;
IO_LOC  "lcd_g[2]"  35;
IO_LOC  "lcd_g[3]"  34;
IO_LOC  "lcd_g[4]"  33;
IO_LOC  "lcd_g[5]"  32;
IO_LOC  "lcd_b[0]"  31;
IO_LOC  "lcd_b[1]"  30;
IO_LOC  "lcd_b[2]"  29;
IO_LOC  "lcd_b[3]"  28;
IO_LOC  "lcd_b[4]"  27;
IO_PORT "lcd_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_hsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_vsync" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_de" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_r[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_r[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_r[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_r[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_r[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_g[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_g[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_g[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_g[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_g[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_g[5]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_b[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_b[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_b[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_b[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_PORT "lcd_b[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
