// Tang Nano 20K (GW2AR-LV18QN88C8/I7) ハーネス配線テスト (top_harness_probe)
// ピンは harness/pins.json / docs/HARNESS.md と同じ。RP2 が駆動する線は FPGA 側でもプルダウンする
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// RP2 -> FPGA (FPGA は入力のみ)
IO_LOC  "spi_sck"   73;
IO_PORT "spi_sck"   IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "spi_copi"  74;
IO_PORT "spi_copi"  IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "spi_cs"    72;
IO_PORT "spi_cs"    IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "rst_in"    86;
IO_PORT "rst_in"    IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// FPGA -> RP2
IO_LOC  "spi_cipo"  75;
IO_PORT "spi_cipo"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "vdp_irq"   71;
IO_PORT "vdp_irq"   IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "vsync_out" 42;
IO_PORT "vsync_out" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "heartbeat" 41;
IO_PORT "heartbeat" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "error_out" 48;
IO_PORT "error_out" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

IO_LOC  "led[0]" 15;
IO_LOC  "led[1]" 16;
IO_LOC  "led[2]" 17;
IO_LOC  "led[3]" 18;
IO_LOC  "led[4]" 19;
IO_LOC  "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
