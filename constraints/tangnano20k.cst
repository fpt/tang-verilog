// Tang Nano 20K (GW2AR-LV18QN88C8/I7)
IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "btn_s1" 88;
IO_PORT "btn_s1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC  "btn_s2" 87;
IO_PORT "btn_s2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC  "led[0]" 15;
IO_LOC  "led[1]" 16;
IO_LOC  "led[2]" 17;
IO_LOC  "led[3]" 18;
IO_LOC  "led[4]" 19;
IO_LOC  "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// HDMI (DVI): TLVDS。p/n を個別に制約する (apicula の examples/tangnano20k.cst と同じ)
IO_LOC  "tmds_clk_p" 33;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_clk_n" 34;
IO_PORT "tmds_clk_n" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_p[0]" 35;
IO_PORT "tmds_d_p[0]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_n[0]" 36;
IO_PORT "tmds_d_n[0]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_p[1]" 37;
IO_PORT "tmds_d_p[1]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_n[1]" 38;
IO_PORT "tmds_d_n[1]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_p[2]" 39;
IO_PORT "tmds_d_p[2]" IO_TYPE=LVDS25 PULL_MODE=NONE;
IO_LOC  "tmds_d_n[2]" 40;
IO_PORT "tmds_d_n[2]" IO_TYPE=LVDS25 PULL_MODE=NONE;
